[
    {
        "id": "tab_temperatura_git",
        "type": "tab",
        "label": "Temperatura - Git y Node-RED",
        "disabled": false,
        "info": "Proyecto de demostracion para explicar Node-RED Projects y GitHub. Inyectar 25 para el caso normal, 35 para alarma y texto para validar la entrada. El umbral de alarma es 30 grados Celsius. No requiere sensores ni servicios externos.",
        "env": []
    },
    {
        "id": "nota_flujo",
        "type": "comment",
        "z": "tab_temperatura_git",
        "name": "1. Inyectar -> 2. Validar y evaluar -> 3. Ver resultado en Debug",
        "info": "Los botones azules permiten probar tres entradas. Deploy guarda y ejecuta el flujo; commit registra una version; push la envia a GitHub; pull incorpora cambios remotos.",
        "x": 410,
        "y": 60,
        "wires": []
    },
    {
        "id": "inject_normal",
        "type": "inject",
        "z": "tab_temperatura_git",
        "name": "Probar normal: 25 C",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temperatura",
        "payload": "25",
        "payloadType": "num",
        "x": 180,
        "y": 160,
        "wires": [["evaluar_temperatura"]]
    },
    {
        "id": "inject_alarma",
        "type": "inject",
        "z": "tab_temperatura_git",
        "name": "Probar alarma: 35 C",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temperatura",
        "payload": "35",
        "payloadType": "num",
        "x": 180,
        "y": 240,
        "wires": [["evaluar_temperatura"]]
    },
    {
        "id": "inject_invalido",
        "type": "inject",
        "z": "tab_temperatura_git",
        "name": "Probar entrada invalida",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "sensor/temperatura",
        "payload": "sin-dato",
        "payloadType": "str",
        "x": 190,
        "y": 320,
        "wires": [["evaluar_temperatura"]]
    },
    {
        "id": "evaluar_temperatura",
        "type": "function",
        "z": "tab_temperatura_git",
        "name": "Evaluar temperatura (umbral 30 C)",
        "func": "const umbral = 30;\nconst temperatura = msg.payload;\n\nif (typeof temperatura !== \"number\" || !Number.isFinite(temperatura)) {\n    msg.payload = {\n        estado: \"ERROR\",\n        mensaje: \"La temperatura debe ser un numero valido\"\n    };\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Entrada invalida\" });\n    return [null, null, msg];\n}\n\nconst alarma = temperatura >= umbral;\nmsg.payload = {\n    temperatura,\n    unidad: \"C\",\n    umbral,\n    estado: alarma ? \"ALARMA\" : \"NORMAL\",\n    mensaje: alarma ? \"Temperatura alta\" : \"Temperatura dentro del rango\"\n};\n\nnode.status({\n    fill: alarma ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: `${temperatura} C - ${msg.payload.estado}`\n});\nreturn alarma ? [null, msg, null] : [msg, null, null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": ["Normal", "Alarma", "Entrada invalida"],
        "x": 510,
        "y": 240,
        "wires": [["debug_normal"], ["debug_alarma"], ["debug_error"]]
    },
    {
        "id": "debug_normal",
        "type": "debug",
        "z": "tab_temperatura_git",
        "name": "NORMAL - temperatura correcta",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 870,
        "y": 160,
        "wires": []
    },
    {
        "id": "debug_alarma",
        "type": "debug",
        "z": "tab_temperatura_git",
        "name": "ALARMA - temperatura alta",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
